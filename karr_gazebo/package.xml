<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>karr_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo (Harmonic) simulation of K.A.R.R. (Keystone Autonomous Resource Rover): worlds, simulated sensors (Livox Mid-360, 3x ZED X One S, dual GNSS), ros2_control hookup, ROS-Gazebo bridge and launch files.</description>
  <maintainer email="dbutani@ltu.edu">Devson Butani</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>karr_description</exec_depend>
  <exec_depend>karr_control</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
