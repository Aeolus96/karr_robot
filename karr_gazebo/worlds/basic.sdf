<?xml version="1.0"?>
<!-- Basic test world: flat ground, a few obstacles (3 in curb, boxes, barrels) and a 15 degree ramp.
     The world origin has a real latitude/longitude so GNSS fixes look realistic. -->
<sdf version="1.9">
  <world name="basic">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- ENU world frame origin. Change to test somewhere else. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>42.4745</latitude_deg>
      <longitude_deg>-83.2495</longitude_deg>
      <elevation>200</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.35 0.45 0.3 1</ambient><diffuse>0.35 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 3 in (0.076 m) curb across the path, 4 m ahead: K.A.R.R. should clear it -->
    <model name="curb">
      <static>true</static>
      <pose>4 0 0.038 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 3 0.076</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 3 0.076</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 15 degree ramp, 2 m long, to the left -->
    <model name="ramp">
      <static>true</static>
      <pose>2 6 0.259 0 -0.2618 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2 1.5 0.02</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2 1.5 0.02</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="ramp_top">
      <static>true</static>
      <pose>3.966 6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2 1.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2 1.5 0.5</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Obstacles for the lidar and cameras -->
    <model name="box_1">
      <static>true</static>
      <pose>7 -2 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>-4 3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 3 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 3 1.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.8 1</ambient><diffuse>0.3 0.3 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="barrel_1">
      <static>true</static>
      <pose>6 2.5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>1 0.45 0 1</ambient><diffuse>1 0.45 0 1</diffuse></material></visual>
      </link>
    </model>
    <model name="barrel_2">
      <static>true</static>
      <pose>2 -3 0.45 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>1 0.45 0 1</ambient><diffuse>1 0.45 0 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
